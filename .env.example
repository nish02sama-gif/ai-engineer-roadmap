# Copy this file to .env and fill in real values.
# .env is listed in .gitignore. Never commit it, never paste keys into code.

# Get a key from the Anthropic Console (console.anthropic.com)
ANTHROPIC_API_KEY=your-key-here

# Model used by the examples. Check docs.claude.com for current model names.
CLAUDE_MODEL=claude-sonnet-5-5
